{
  "name": "quorumpatch",
  "version": "2026.9.2",
  "private": true,
  "description": "Counterfactual repair verification with isolated Solari witnesses and human review.",
  "license": "MIT",
  "keywords": [
    "solari",
    "software-verification",
    "coding-agents",
    "counterfactual-testing",
    "evidence"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "proof:local": "node scripts/open-source-proof.mjs",
    "proof:cloud": "node --env-file-if-exists=.env.local scripts/open-source-proof.mjs --cloud",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run privacy:check && npm test && tsc --noEmit && npm run build",
    "privacy:check": "node scripts/privacy-check.mjs",
    "demo:local": "node scripts/synthetic-proof.mjs",
    "demo:cloud": "node --env-file-if-exists=.env.local scripts/synthetic-proof.mjs --cloud",
    "devlog:prepare": "devlog-release prepare --production",
    "devlog:check": "devlog-release check --production",
    "release:push": "node scripts/release-push.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aribradshaw/devlog": "^1.0.4",
    "@base-ui/react": "1.7.0",
    "@solarisdk/browser": "^0.1.1",
    "@solarisdk/sdk": "^0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/workers-types": "5.20260916.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.133.0"
  },
  "type": "module"
}
